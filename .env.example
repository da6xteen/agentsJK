# SAQ QURYLYS Environment Variables Example
# All keys are optional. The system works out-of-the-box in keyless fallback mode.

# Telegram API credentials (optional, for Telethon full client if used instead of public web preview)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Instagram Graph API token (optional, for official API stub mode)
INSTAGRAM_GRAPH_TOKEN=

# LLM API credentials (for future AI agents, optional)
OPENAI_API_KEY=
