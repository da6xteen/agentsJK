# SAQ QURYLYS Environment Variables Example
# All keys are optional. The system works out-of-the-box in keyless fallback mode.

# Database path (default: saq_qurylys.db)
DB_PATH=saq_qurylys.db

# LLM API credentials (optional, for Anthropic Claude or OpenAI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# Agent 2 Matcher Thresholds
LINKING_CONFIDENCE_THRESHOLD=0.75
LINKING_MARGIN_THRESHOLD=0.15

# Telegram API credentials (optional, for Telethon full client)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Instagram Graph API token (optional)
INSTAGRAM_GRAPH_TOKEN=
